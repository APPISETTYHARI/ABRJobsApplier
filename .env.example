# ABRJobsApplier — Environment Variables
# Copy this to .env for local development
# Add these directly in Railway or Render dashboard (never commit .env to GitHub)

# ── Jobs API (FREE — 500 requests/month) ──────────────────
# Get at: https://rapidapi.com → search "JSearch" → subscribe free
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Gmail OAuth2 (FREE — read-only) ───────────────────────
# Get at: https://console.cloud.google.com
# Full instructions in README.md Step 5
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=https://your-app.up.railway.app/auth/gmail/callback
GMAIL_REFRESH_TOKEN=

# ── Server ────────────────────────────────────────────────
# DO NOT set PORT here — Railway/Render set it automatically
